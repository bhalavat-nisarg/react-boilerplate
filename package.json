{
  "name": "react-boilerplate",
  "version": "4.0.0",
  "description": "A highly scalable, offline-first foundation with the best DX and a focus on performance and best practices",
  "repository": {
    "type": "git",
    "url": "git://github.com/react-boilerplate/react-boilerplate.git"
  },
  "engines": {
    "npm": ">=5",
    "node": ">=22.12.0"
  },
  "author": "Max Stoiber",
  "license": "MIT",
  "scripts": {
    "analyze:clean": "rimraf stats.json",
    "preanalyze": "npm run analyze:clean",
    "analyze": "node ./internals/scripts/analyze.js",
    "extract-intl": "node ./internals/scripts/extract-intl.js",
    "npmcheckversion": "node ./internals/scripts/npmcheckversion.js",
    "preinstall": "npm run npmcheckversion",
    "prebuild": "npm run build:clean",
    "build": "cross-env NODE_ENV=production webpack --config internals/webpack/webpack.prod.babel.js --color --progress --stats-optimization-bailout",
    "build:clean": "rimraf ./build",
    "start": "cross-env NODE_ENV=development node server",
    "start:production": "npm run test && npm run build && npm run start:prod",
    "start:prod": "cross-env NODE_ENV=production node server",
    "setup": "node ./internals/scripts/setup.js",
    "clean": "shjs ./internals/scripts/clean.js",
    "clean:all": "npm run analyze:clean && npm run test:clean && npm run build:clean",
    "generate": "plop --plopfile internals/generators/index.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:css": "stylelint app/**/*.js",
    "lint:eslint": "eslint --ignore-path .gitignore --ignore-pattern internals/scripts",
    "lint:eslint:fix": "eslint --ignore-path .gitignore --ignore-pattern internals/scripts --fix",
    "lint:js": "npm run lint:eslint -- . ",
    "lint:staged": "lint-staged",
    "pretest": "npm run test:clean && npm run lint",
    "test:clean": "rimraf ./coverage",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --watchAll",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "prettify": "prettier --write",
    "presetup": "npm install --no-save --legacy-peer-deps chalk@2.4.2 shelljs@0.10.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "IE 10"
  ],
  "lint-staged": {
    "*.js": [
      "npm run lint:eslint:fix",
      "git add --force"
    ],
    "*.json": [
      "prettier --write",
      "git add --force"
    ]
  },
  "pre-commit": "lint:staged",
  "dependencies": {
    "@babel/polyfill": "7.4.3",
    "chalk": "2.4.2",
    "compression": "1.8.2",
    "connected-react-router": "6.9.3",
    "cross-env": "10.1.0",
    "express": "4.22.1",
    "fontfaceobserver": "2.1.0",
    "history": "4.9.0",
    "hoist-non-react-statics": "3.3.0",
    "immer": "9.0.6",
    "immutable": "4.3.9",
    "intl": "1.2.5",
    "invariant": "2.2.4",
    "lodash": "4.18.1",
    "minimist": "1.2.6",
    "prop-types": "15.7.2",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "react-helmet": "6.0.0-beta",
    "react-intl": "2.8.0",
    "react-redux": "7.2.9",
    "react-router-dom": "5.3.4",
    "redux": "4.0.1",
    "redux-saga": "1.0.2",
    "reselect": "4.0.0",
    "sanitize.css": "8.0.0",
    "styled-components": "4.2.0"
  },
  "overrides": {
    "immutable": "$immutable",
    "fast-uri": "3.1.9",
    "minimatch@<5": "$minimatch-compat",
    "minimatch@>=5": "11.0.4",
    "offline-plugin": {
      "loader-utils": "2.0.4"
    },
    "serialize-javascript": "7.1.4",
    "jest-styled-components": {
      "css": "npm:@adobe/css-tools@4.5.0"
    },
    "qs": "6.17.1",
    "glob@>=9": "14.0.3",
    "js-yaml@>=4": "4.3.2",
    "jest-config": {
      "deepmerge": "$jest-deepmerge"
    }
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.6",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/plugin-transform-react-constant-elements": "7.29.7",
    "@babel/plugin-transform-react-inline-elements": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/register": "7.29.7",
    "@testing-library/jest-dom": "6.9.1",
    "add-asset-html-webpack-plugin": "6.0.0",
    "ajv": "8.20.0",
    "babel-jest": "30.5.2",
    "babel-loader": "9.2.1",
    "babel-plugin-dynamic-import-node": "2.2.0",
    "babel-plugin-lodash": "3.3.4",
    "babel-plugin-react-intl": "3.0.1",
    "babel-plugin-styled-components": "1.10.0",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "circular-dependency-plugin": "5.2.2",
    "compare-versions": "3.4.0",
    "compression-webpack-plugin": "12.0.0",
    "coveralls": "npm:coveralls-next@6.0.2",
    "css-loader": "7.1.5",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "17.1.0",
    "eslint-config-airbnb-base": "13.1.0",
    "eslint-config-prettier": "8.10.2",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "3.4.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-redux-saga": "1.3.3",
    "glob": "14.0.3",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.8",
    "image-minimizer-webpack-plugin": "5.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.5.2",
    "jest-deepmerge": "file:./internals/compat/jest-deepmerge",
    "jest-environment-jsdom": "30.5.2",
    "jest-styled-components": "6.3.4",
    "lint-staged": "16.4.0",
    "mini-svg-data-uri": "1.4.4",
    "minimatch-compat": "file:./internals/compat/minimatch",
    "node-plop": "0.32.3",
    "null-loader": "4.0.1",
    "offline-plugin": "npm:@lcdp/offline-plugin@6.0.1",
    "plop": "4.0.5",
    "postcss-styled-syntax": "0.7.4",
    "pre-commit": "2.0.0",
    "prettier": "1.17.0",
    "react-app-polyfill": "0.2.2",
    "react-test-renderer": "16.8.6",
    "react-testing-library": "npm:@testing-library/react@12.1.5",
    "rimraf": "6.1.4",
    "sharp": "0.35.5",
    "shelljs": "0.10.0",
    "style-loader": "4.0.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "16.0.0",
    "svgo": "4.1.0",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.112.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-middleware": "7.4.5",
    "webpack-hot-middleware": "2.26.1",
    "whatwg-fetch": "3.0.0"
  }
}
